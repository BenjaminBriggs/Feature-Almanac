{
  "name": "feature-almanac",
  "version": "0.1.0",
  "description": "Feature Almanac: a git-stored spec of everything an app does, and the almanac CLI",
  "keywords": [
    "specification",
    "documentation",
    "behaviour",
    "gherkin",
    "ai-agents",
    "cli"
  ],
  "homepage": "https://github.com/BenjaminBriggs/Feature-Almanac#readme",
  "bugs": "https://github.com/BenjaminBriggs/Feature-Almanac/issues",
  "license": "MIT",
  "author": "Ben Briggs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenjaminBriggs/Feature-Almanac.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "almanac": "./bundle/bin/almanac.js"
  },
  "files": [
    "bundle",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "prepack": "node scripts/bundle.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "commander": "^14.0.3",
    "diff": "^8.0.4",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@feature-almanac/core": "0.1.0",
    "@feature-almanac/schema": "0.1.0",
    "@feature-almanac/site": "0.1.0"
  }
}
